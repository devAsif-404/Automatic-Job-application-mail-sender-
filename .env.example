# Application URL & Security
APP_URL=http://localhost:3000
# 32-byte hex string (64 hex characters) or standard key for AES-256-GCM encryption of stored secrets
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hremaildb?schema=public"

# Redis Configuration (Optional for BullMQ queue; falls back to in-app DB queue runner if not reachable)
REDIS_URL="redis://localhost:6379"

# SMTP Email Configuration
# Examples for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false (use STARTTLS on port 587, or true on port 465)
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_digit_app_password
# EMAIL_FROM="Your Name <your_email@gmail.com>"
# EMAIL_REPLY_TO=your_email@gmail.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM="Your Name <user@example.com>"
EMAIL_REPLY_TO=user@example.com

# Bulk Sending Controls
MAX_SEND_CONCURRENCY=2
SEND_DELAY_MS=3000

